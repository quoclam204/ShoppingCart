@model IEnumerable<OrderDetails>

@{
    ViewData["Title"] = "Order Details";

    decimal subtotal = 0; // thành tiền của sản phẩm đó (tổng phụ)
    decimal total = 0; // tổng tiền cuối cùng (của tất cả sản phẩm)
}

<h3>Chi tiết đơn hàng</h3>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Tên khách hàng</th>
            <th scope="col">Sản phẩm</th>
            <th scope="col">Mã đơn hàng</th>
            <th scope="col">Giá</th>
            <th scope="col">Số lượng</th>
            <th scope="col">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            subtotal = item.Quantity * item.Price;
            total += subtotal;

            <tr>
                <input type="hidden" asp-for="@item.OrderCode" class="getId" />
                <td>@item.UserName</td>
                <td>@item.Product.Name</td>
                <td>@item.OrderCode</td>
                <td>@item.Price</td>
                <td>@item.Quantity</td>
                <td>@subtotal.ToString("C")</td>

            </tr>
        }

        <tr>
            <th colspan="5">Total:</th>
            <td>@total.ToString("C")</td>
            <td>
                <select class="form-control select-update-order">
                    <option value="1">Đơn hàng mới</option>
                    <option value="0">Đã xử lý</option>
                </select>
            </td>
        </tr>
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {

            $('.select-update-order').change(function () {

                var status = $(this).val();
                var ordercode = $('.getId').val();

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("UpdateOrder")",
                    data: {
                        status: status,
                        ordercode: ordercode
                    }, // Send data to the server

                    success: function (result) {
                        // Handle successful update
                        if (result.success) {
                            Swal.fire({
                                position: "top-end",
                                icon: "success",
                                title: "Cập nhật đơn hàng thành công.",
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                        else {
                            Swal.fire({
                                position: "top-end",
                                icon: "success",
                                title: "Cập nhật đơn hàng thất bại!" + result.message,
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    },

                    error: function (req, status, error) {
                        console.error("Error updating order:", error);
                    }
                });

            });

        });
    </script>
}