@model IEnumerable<OrderModel>

@{
    ViewData["Title"] = "Order Listed";

    Paginate pager = new Paginate();

    int pageNo = 0;

    if (ViewBag.Pager != null)
    {
        pager = ViewBag.Pager;
        pageNo = pager.CurrentPage;
    }
}

<h3>Danh sách đơn hàng</h3>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">Mã đơn hàng</th>
            <th scope="col">Tên đăng nhập của người đặt hàng</th>
            <th scope="col">Phí vận chuyển</th>
            <th scope="col">Ngày và giờ tạo đơn hàng</th>
            <th scope="col">Trạng thái của đơn hàng</th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderCode</td>
                <td>@item.UserName</td>
                <td>@item.ShippingCost.ToString("#,##0 VNĐ")</td>
                <td>@item.CreatedDate.ToString("dd/MM/yyyy | HH:mm:ss")</td>

                <td>
                    @if (@item.Status == 1)
                    {
                        <span class="text text-success">Đơn hàng mới</span>
                    }
                    else
                    {
                        <span class="text text-danger">Đã xử lý</span>
                    }
                </td>

                <td>
                    <a asp-action="ViewOrder" class="btn btn-warning btn-sm" asp-controller="Order" asp-route-ordercode="@item.OrderCode">Xem đơn hàng</a>
                    <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Order" asp-route-ordercode="@item.OrderCode">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<partial name="_paging" model="@pager" />