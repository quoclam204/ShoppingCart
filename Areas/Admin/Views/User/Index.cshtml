@model IEnumerable<AppUserModel>

@{
    ViewData["Title"] = "List User";
}

<h3>Danh sách User</h3>

<a asp-action="Create" asp-controller="User" class="btn btn-primary btn-sm">Thêm User</a>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">User Name</th>
            <th scope="col">Email</th>
            <th scope="col">Password Hash</th>
            <th scope="col">Phone Number</th>
            <th scope="col">Role</th>       
        </tr>
    </thead>
    <tbody> 
        @foreach (var user in Model)
        {
            <tr>
                <th scope="row">@user.Id</th>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.PasswordHash</td>
                <td>@user.PhoneNumber</td>
                <td></td>

                <td>
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="User" asp-route-Id="@user.Id">Sửa</a>
                    <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-controller="User" asp-route-Id="@user.Id">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>