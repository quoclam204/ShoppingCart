@* View này nhận 1 đối tượng duy nhất *@
@model SliderModel

@{
    ViewData["title"] = "Edit Banner";
}

<h3>Sửa banner</h3>

<div class="col-md-9">
    <form asp-action="Edit" asp-controller="Slider" enctype="multipart/form-data">

        <input type="hidden" asp-for="@Model.Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>      
        <div class="form-group">
            <label>Tên</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Mô tả</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Trạng thái</label>
            <select asp-for="Status" class="form-control">
                @if (Model.Status == 1)
                {
                    <option value="1" selected>Hiển thị</option>
                    <option value="0">Ẩn</option>
                }
                else
                {
                    <option value="1">Hiển thị</option>
                    <option value="0" selected>Ẩn</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Hình ảnh</label>
            <input asp-for="ImageUpLoad" class="form-control" />
            <span asp-validation-for="ImageUpLoad" class="text-danger"></span>
            <img src="~/media/sliders/@Model.Image" width="400px" height="200px" />
            <img id="imgpreview" class="pt-2" />
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Edit banner</button>
        </div>

    </form>

    <a asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i> Quay lại trang banner
    </a>

</div>

@* nạp JavaScript cho trang hiện tại. *@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

    <script>
        $("#ImageUpLoad").change(function() {
            readURL(this);
        })
    </script>

    <script>
        CKEDITOR.replace('Description', {
            versionCheck: false
        });
    </script>
}