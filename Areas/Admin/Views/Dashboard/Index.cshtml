@model StatisticalModel

@{
    ViewData["Title"] = "Dashboard";
}

<h3>Thống kê tổng quan</h3>



<div class="row">
    <div class="col-md-3">
        <p>Thống kê sản phẩm</p>
        @ViewBag.CountProduct
    </div>

    <div class="col-md-3">
        <p>Thống kê đơn hàng</p>
        @ViewBag.CountOrder
    </div>

    <div class="col-md-3">
        <p>Thống kê danh mục</p>
        @ViewBag.CountCategory
    </div>

    <div class="col-md-3">
        <p>Thống kê người dùng</p>
        @ViewBag.CountUser
    </div>
</div>
<br />

<div class="row">
    <div class="col-md-3">

        <h4>Thống kê theo:</h4>

        <select class="filter-select">
            <option value="30">---Lọc dữ liệu---</option>
            <option value="7">7 ngày trước</option>
            <option value="30">Tháng qua-</option>
            <option value="90">3 tháng trước</option>
            <option value="365">1 năm</option>
        </select>
    </div>

    <div class="col-md-3">
        <h4>Lọc theo ngày:</h4>
        <label>Từ ngày</label>
        <input type="date" id="date_form" class="form-control" asp-for="@Model.DateCreated" />
        <label>Đến ngày</label>
        <input type="date" id="date_to" class="form-control" asp-for="@Model.DateCreated" />
        <button id="filterButton" class="btn btn-primary">Lọc</button>
    </div>
</div>

<h4>Biểu đồ thống kê</h4>

<div id="myfirstchart" style="height: 250px;"></div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Tạo biểu đồ lấy dữ liệu từ controller
            var chartMorris = new Morris.Line({
                element: 'myfirstchart',

                data: [],
                xkey: 'date',

                ykeys: ['sold', 'quantity', 'revenue', 'profit'],
                labels: ['Số lượng bán ra', 'Đơn hàng', 'Doanh thu', 'Lợi nhuận'],
            });

            // Gọi controller bằng AJAX
            $.ajax({
                url: "@Url.Action("GetChartData", "Dashboard")",
                type: "POST",
                dataType: "json", // nhận dữ liệu trả về dưới dạng JSON
                success: function (data) {
                    if (data){
                        chartMorris.setData(data.map(function (item) {
                            return {
                                date: item.date,
                                sold: item.sold,
                                quantity: item.quantity,
                                revenue: item.revenue,
                                profit: item.profit
                            };
                        }));
                    }
                    else {
                        console.error("Không có dữ liệu nhân được cho biểu đồ.");
                        chartMorris.setData([]); // Xóa dữ liệu nếu không hợp lệ
                    }
                },
                // Nếu Ajax lỗi
                error: function (error) {
                    console.error("Lỗi khi lấy dữ liệu biểu đồ:", error);
                }
            });


            // Lọc dữ liệu theo thời gian
            $('.filter-select').on('change', function() {
                var days = $(this).val(); // Lấy giá trị được chọn từ người dùng
                var endDate = new Date(); // Lấy ngày hiện tại

                // Lấy thời điểm hiện tại - days trong quá khứ sau đó chuyển số đó thành ngày tháng
                var startDate = new Date(endDate.getTime() - days * 24 * 60 * 60 * 1000); // Tính ngày bắt đầu

                $.ajax({
                    // gọi action trong controller
                    url: "@Url.Action("GetChartDataBySelect", "Dashboard")",
                    type: "POST",
                    dataType: "json",
                    data: {
                        startDate: startDate.toISOString().split('T')[0], // Chuyển đổi sang định dạng yyyy-MM-dd
                        endDate: endDate.toISOString().split('T')[0] // Chuyển đổi sang định dạng yyyy-MM-dd
                    },
                    success: function (data) {
                        if (data) {
                            chartMorris.setData(data.map(function (item) {
                                return {
                                    date: item.date,
                                    sold: item.sold,
                                    quantity: item.quantity,
                                    revenue: item.revenue,
                                    profit: item.profit
                                };
                            }));
                        } else {
                            console.error("Không có dữ liệu nhận được cho biểu đồ.");
                            chartMorris.setData([]); // Xóa dữ liệu nếu không hợp lệ
                        }
                    },
                    error: function (error) {
                        console.error("Lỗi khi lấy dữ liệu biểu đồ:", error);
                    }
                });
            });

            // Lọc theo tùy chọn
            $("#filterButton").click(function () {
                var fromDate = $("#date_form").val();
                var toDate = $("#date_to").val();

                $.ajax({
                    url: "@Url.Action("FilterData", "Dashboard")",
                    type: "POST",
                    // gửi dữ liệu lên controller
                    data: { fromDate: fromDate, toDate: toDate},
                    success: function (data) {
                        if (data) {
                            chartMorris.setData(data.map(function (item) {
                                return {
                                    date: item.date,
                                    sold: item.sold,
                                    quantity: item.quantity,
                                    revenue: item.revenue,
                                    profit: item.profit
                                };
                            }));
                        } else {
                            console.error("Không có dữ liệu nhận được cho biểu đồ.");
                            chartMorris.setData([]); // Xóa dữ liệu nếu không hợp lệ
                        }
                    },
                    error: function (error) {
                        console.error("Lỗi khi lấy dữ liệu biểu đồ:", error);
                    }
                });
            });
        });
    </script>
}