@* View này nhận 1 đối tượng duy nhất *@
@model ProductModel

@{
    ViewData["title"] = "Create Product";
}

<h3>Thêm sản phẩm</h3>

<div class="col-md-9">
    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label>Tên</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Giá</label>

            <!-- Ô nhập giá -->
            <input asp-for="Price" pattern="[0-9.,]+" class="form-control typing-price " />

            <!-- Hiển thị giá đã được định dạng -->
            <span id="price-convert"></span>

            <!-- Hiển thị lỗi validation -->
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Giá vốn</label>

            <!-- Ô nhập giá -->
            <input asp-for="CapitalPrice" pattern="[0-9.,]+" class="form-control typing-capital-price " />

            <!-- Hiển thị giá đã được định dạng -->
            <span id="capital-price-convert"></span>

            <!-- Hiển thị lỗi validation -->
            <span asp-validation-for="CapitalPrice" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Mô tả</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Danh mục</label>
            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
                <option>--Choose a category</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Thương hiệu</label>
            <select asp-for="BrandId" class="form-control" asp-items="ViewBag.Brands">
                <option>--Choose a brand</option>
            </select>
            <span asp-validation-for="BrandId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Hình ảnh</label>
            <input asp-for="ImageUpLoad" class="form-control" />
            <span asp-validation-for="ImageUpLoad" class="text-danger"></span>
            <img id="imgpreview" class="pt-2"/>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Thêm sản phẩm</button>
        </div>

    </form>

    <a asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i> Quay lại trang sản phẩm
    </a>

</div>

@* nạp JavaScript cho trang hiện tại. *@
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>

    <!--Hiển thị ảnh trên View-->
    <script>
        $("#ImageUpLoad").change(function() {
            readURL(this);
        })
    </script>

    <script>
        CKEDITOR.replace('Description', {
            versionCheck: false
        });
    </script>

    <script>
        // Khi người dùng nhập giá vào ô input có class "typing-price"
        $(".typing-price").on("keyup", function () {

            // Lấy giá trị người dùng vừa nhập
            var currency_input = $(this).val();

            // Định dạng số thành tiền Việt Nam và hiển thị vào phần tử có id="price-convert"
            $("#price-convert").html(
                new Intl.NumberFormat('vi-VN', {
                    style: 'currency',   // Định dạng kiểu tiền tệ
                    currency: 'VND'      // Đơn vị tiền là Việt Nam Đồng
                }).format(currency_input) // Chuyển số thành định dạng tiền
            );
        });

        $(".typing-capital-price").on("keyup", function () {

            // Lấy giá trị người dùng vừa nhập
            var currency_input = $(this).val();

            // Định dạng số thành tiền Việt Nam và hiển thị vào phần tử có id="price-convert"
            $("#capital-price-convert").html(
                new Intl.NumberFormat('vi-VN', {
                    style: 'currency',   // Định dạng kiểu tiền tệ
                    currency: 'VND'      // Đơn vị tiền là Việt Nam Đồng
                }).format(currency_input) // Chuyển số thành định dạng tiền
            );
        });
    </script>
}