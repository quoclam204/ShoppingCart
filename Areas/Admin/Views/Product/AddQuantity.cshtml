@* View này nhận 1 đối tượng duy nhất *@
@model ProductQuantityModel

@{
    ViewData["title"] = "Create Quantity";
}

<h3>Thêm số lượng nhập vào kho</h3>

<div class="col-md-9">
    <form asp-action="StoreProductQuantity" asp-controller="Product" enctype="multipart/form-data">

        <input type="hidden" asp-for="ProductId" value="@ViewBag.Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label>Số lượng</label>
            <input min="1" value="1" max="2000" asp-for="Quantity" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Thêm số lượng</button>
        </div>

    </form>

    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i> Quay lại trang sản phẩm
    </a>

</div>

@section Scripts {
    @* Kiểm tra dữ liệu đầu vào *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}