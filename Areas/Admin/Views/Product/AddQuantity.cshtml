@* View này nhận 1 đối tượng duy nhất *@
@model ProductQuantityModel

@{
    ViewData["title"] = "Create Quantity";

    var total_quantities = 0;
    var key = 1;
}

<h3>Thêm số lượng nhập vào kho</h3>

<div class="col-md-9">
    <form asp-action="StoreProductQuantity" asp-controller="Product" enctype="multipart/form-data">

        @* Hiển thị số lượng sản phẩm đó lến view theo id từ controller *@
        <input type="hidden" asp-for="ProductId" value="@ViewBag.Id" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label>Số lượng</label>
            <input min="1" value="1" max="2000" asp-for="Quantity" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Thêm số lượng</button>
        </div>

    </form>

    <h3>Số lượng sản phẩm hiện có</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Số lượng nhập</th>
                <th>Ngày nhập</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var productQuantity in ViewBag.ProductByQuantity)
            {
                total_quantities += productQuantity.Quantity;
                <tr>
                    <td>@key</td>
                    <td>@productQuantity.Quantity</td>
                    <td>@productQuantity.DateCreated</td>
                </tr>
                key++;
            }
            <tr>
                <td>Tổng số lượng: @total_quantities</td>
            </tr>
        </tbody>
    </table>
        
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i> Quay lại trang sản phẩm
    </a>

</div>

@section Scripts {
    @* Kiểm tra dữ liệu đầu vào *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}