@* Kết nối với ProductController *@
@* View này nhận một danh sách nhiều sản phẩm *@
@model IEnumerable<ProductModel>

@{
    ViewData["Title"] = "Product Listed";
}
    
<h3>Danh sách sản phẩm</h3>

<a asp-action="Create" asp-controller="Product" class="btn btn-primary btn-sm">Thêm sản phẩm</a>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Tên sản phẩm</th>
            <th scope="col">Số lượng sản phẩm</th>
            <th scope="col">Đã bán</th>
            <th scope="col">Mô tả</th>
            <th scope="col">Giá</th>
            <th scope="col">Giá vốn</th>
            <th scope="col">Hỉnh ảnh</th>
            <th scope="col">Tên URL của sản phẩm</th>
            <th scope="col">Danh mục</th>
            <th scope="col">Thương hiệu</th>
            <th scope="col">Quản lý sản phẩm</th>
        </tr>
    </thead>    
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <th scope="row">@item.Id</th>
                <td>@item.Name</td>
                <td><b>@item.Quantity</b><br/><a asp-controller="Product" asp-action="AddQuantity" asp-route-id="@item.Id">Thêm số lượng</a> </td>
                <td><b>@item.Sold</b></td>
                <td>@Html.Raw(item.Description)</td>
                <td>@item.Price.ToString("#,##0 VNĐ")</td>
                <td>@item.CapitalPrice.ToString("#,##0 VNĐ")</td>
                <td><img src="~/media/products/@item.Image" width="120px">
                <td>@item.Slug</td>
                <td>@item.Category.Name</td>
                <td>@item.Brand.Name</td>
                <td>
                    <a asp-action="Edit" class="btn btn-warning btn-sm" asp-controller="Product" asp-route-Id="@item.Id">Sửa</a>
                    <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Product" asp-route-Id="@item.Id">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>