@* View này nhận 1 đối tượng duy nhất *@
@model CouponModel

@{
    ViewData["title"] = "Create Coupon";
}

<h3>Thêm khuyến mãi</h3>

<div class="col-md-9">
    <form asp-action="Create" autocomplete="off" asp-controller="Coupon" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label>Tên khuyến mãi</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Mô tả</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Số lượng</label>
            <input min="1" value="1" max="2000" asp-for="Quantity" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Ngày bắt đầu</label>
            <input asp-for="DateStart" class="form-control" />
            <span asp-validation-for="DateStart" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Ngày hết hạn</label>
            <input asp-for="DateExpỉed" class="form-control" />
            <span asp-validation-for="DateExpỉed" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Trạng thái</label>

            @* select dùng để tạo dropdown *@
            <select asp-for="Status" class="form-control">
                <option value="1">Hiển thị</option>
                <option value="0">Ẩn</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">Thêm</button>
        </div>

    </form>

    <h5>Danh sách khuyến mãi</h5>
    <table class="table table-striped" id="myTable">
        <thead>
            <tr>
                <th>Tên khuyến mãi</th>
                <th>Mô tả</th>
                <th>Số lượng</th>
                <th>Ngày bắt đầu</th>
                <th>Ngày hết hạn</th>
                <th>Trạng thái</th>
                <th>Hạn dùng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var coupon in ViewBag.CouponList)
            {
                <tr>
                    <td>@coupon.Name</td>
                    <td>@Html.Raw(@coupon.Description)</td>
                    <td>@coupon.Quantity</td>
                    <td>@coupon.DateStart.ToString("dd/MM/yyyy")</td>
                    <td>@coupon.DateExpỉed.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (coupon.Status == 1)
                        {
                            <select name="Status">
                                <option selected value="1">Kích hoạt</option>
                                <option value="0">Ẩn</option>
                            </select>
                        }
                        else
                        {
                            <select name="Status">
                                <option value="1">Kích hoạt</option>
                                <option selected value="0">Ẩn</option>
                            </select>
                        }
                    </td>

                    <td>
                        @if (coupon.DateExpỉed < DateTime.Now)
                        {
                            <span class="text text-danger">Đã hết hạn</span>
                        }
                        else
                        {
                            // Tính khoản thời gian còn lại
                            TimeSpan remainingTime = coupon.DateExpỉed - DateTime.Now;
                            int daysRemaining = remainingTime.Days;

                            if (daysRemaining == 0)
                            {
                                // Nếu hết hạn trong hôm nay
                                <span class="text text-danger">Hôm nay</span>
                            }
                            else
                            {
                                <span class="text text-success">Còn @daysRemaining ngày</span>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @* Kiểm tra dữ liệu đầu vào *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('Description', {
            versionCheck: false
        });
    </script>
}