@model IEnumerable<OrderModel>

@{
    ViewData["Title"] = "List History Order placed by" + " " + @ViewBag.UserEmail;
}

<h3>Danh sách lịch sử đơn hàng bởi @ViewBag.UserEmail</h3>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">Mã đơn hàng</th>
            <th scope="col">Tên đăng nhập của người đặt hàng</th>
            <th scope="col">Phí vận chuyển</th>
            <th scope="col">Mã giảm giá</th>
            <th scope="col">Ngày và giờ tạo đơn hàng</th>
            <th scope="col">Trạng thái của đơn hàng</th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderCode</td>
                <td>@item.UserName</td>
                <td>@item.ShippingCost.ToString("#,##0 VNĐ")</td>
                <td>@Html.Raw(@item.CouponCode)</td>
                <td>@item.CreatedDate.ToString("dd/MM/yyyy | HH:mm:ss")</td>

                <td>
                    @if (@item.Status == 1)
                    {
                        <span class="text text-success">Đơn hàng mới</span>
                    }
                    else if (@item.Status == 2)
                    {
                        <span class="text text-primary">Đã xử lý</span>
                    }
                    else
                    {
                        <span class="text text-danger">Đã hủy</span>
                    }
                </td>

                <td>
                    @* = 3 thì sẽ ẩn nút hủy đơn hàng *@
                    @if (@item.Status != 3)
                    {
                        <a onclick="return confirm('Xác nhận hủy đơn.')" asp-action="CancelOrder" class="btn btn-danger btn-sm" asp-controller="Account" asp-route-ordercode="@item.OrderCode">Hủy đơn hàng</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>