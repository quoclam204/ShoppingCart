@model AppUserModel

@{
	ViewData["Title"] = "Cập nhật thông tin tài khoản";
}

<section id="">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-8 col-sm-offset-1">
				<div class="signup-form">
					<!--sign up form-->
					<h2>Cập nhật thông tin tài khoản</h2>
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<form autocomplete="off" asp-action="UpdateInfoAccount" asp-controller="Account" method="POST">
						<input type="hidden" asp-for="Id"/>

						<div class="form-group">
							<label>Tên đăng nhập</label>
							<input asp-for="UserName" readonly required class="form-control" />
							<span asp-validation-for="UserName" class="text-danger"></span>
						</div>

						<div class="form-group">
							<label>Email</label>
							<input asp-for="Email" readonly required class="form-control" />
							<span asp-validation-for="Email" class="text-danger"></span>
						</div>

						<div class="form-group">
							<label>Số điện thoại</label>
							<input asp-for="PhoneNumber" class="form-control" />
							<span asp-validation-for="PhoneNumber" class="text-danger"></span>
						</div>

						<div class="form-group">
							<label>Mật khẩu cũ</label>
							<input type="text" readonly value="@Model.PasswordHash" class="form-control" />
						</div>

						<div class="form-group">
							<label>Mật khẩu mới</label>
							<input type="text" name="PasswordHash" class="form-control" />
							<span asp-validation-for="PasswordHash" class="text-danger"></span>
						</div>

						<button class="btn btn-default">Cập nhật</button>
					</form>
				</div><!--/sign up form-->
			</div>
		</div>
	</div>
</section><!--/form-->

@section Scripts {
	@* Kiểm tra dữ liệu đầu vào *@
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}