@* @model UserModel *@
@model AppUserModel

@{
	ViewData["Title"] = "Quên mật khẩu";
}

<section id="">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-8 col-sm-offset-1">
				<div class="login-form">
					<!--login form-->
					<h2>Quên mật khẩu</h2>
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<form asp-action="SendMailForgetPass" asp-controller="Account">

						<div class="form-group">
							<label>Email</label>
							<input asp-for="Email" class="form-control" />
							<span asp-validation-for="Email" class="text-danger"></span>
						</div>

						<button class="btn btn-default">Gửi</button>

						<a asp-action="Create" asp-controller="Account" class="btn btn-outline-primary">
							<i class="bi bi-arrow-left"></i> Đăng ký tài khoản
						</a> <br />
					</form>
				</div><!--/login form-->
			</div>
		</div>
	</div>
</section><!--/form-->

@section Scripts {
	@* Kiểm tra dữ liệu đầu vào *@
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}