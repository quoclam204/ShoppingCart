@* @model UserModel *@
@model LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<section id="">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-8 col-sm-offset-1">
				<div class="login-form">
					<!--login form-->
					<h2>Đăng nhập vào tài khoản</h2>
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<form asp-controller="Account" asp-action="Login">

						<div class="form-group">	
							<label>Tên đăng nhập</label>
							<input asp-for="Username" class="form-control" />
							<span asp-validation-for="Username" class="text-danger"></span>
						</div>

						<div class="form-group">
							<label>Mật khẩu</label>
							<input asp-for="Password" class="form-control" />
							<span asp-validation-for="Password" class="text-danger"></span>
						</div>

						<button class="btn btn-default">Login</button>

						<a asp-controller="Account" asp-action="LoginByGoogle" class="btn btn-outline-primary">
							<i class="bi bi-arrow-left"></i> Đăng nhập bằng Google
						</a> <br />

						<a asp-controller="Account" asp-action="Create" class="btn btn-outline-primary">
							<i class="bi bi-arrow-left"></i> Đăng ký tài khoản
						</a> <br />

						<a asp-controller="Account" asp-action="ForgetPass" class="btn btn-outline-primary">
							<i class="bi bi-arrow-left"></i> Quên mật khẩu
						</a>
					</form>
				</div><!--/login form-->
			</div>
		</div>
	</div>
</section><!--/form-->

@section Scripts {
	@* Kiểm tra dữ liệu đầu vào *@
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}