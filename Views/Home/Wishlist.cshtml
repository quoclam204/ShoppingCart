@{
    ViewData["Title"] = "List Wishlist";

    var key = 0;
}

<h3>Danh sách yêu thích</h3>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">STT</th>
            <th scope="col">Tên sản phẩm</th>
            <th scope="col">Mô tả</th>
            <th scope="col">Giá</th>
            <th scope="col">Hình ảnh</th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var wishlist_product in Model)
        {
            key++;
            <tr>
                <th>@key</th>
                <td>@wishlist_product.Product.Name</td>
                <td>@Html.Raw(wishlist_product.Product.Description)</td>
                <td>@wishlist_product.Product.Price.ToString("#,##0 VNĐ")</td>
                <td><img src="~/media/products/@wishlist_product.Product.Image" width="120px">
                <td>
                    <a asp-action="DeleteWishlist" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Home" asp-route-Id="@wishlist_product.Wishlist.Id">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>