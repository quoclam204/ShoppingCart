@model IEnumerable<ProductModel>

<partial name="_SliderPartial" />

<div class="col-sm-3">
    @Html.Partial("_SidebarPartial")
</div>

<style>
    .product-image-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 450px; /* dùng min-height thay vì height cố định */
    }

    .single-products {
        flex: 1;
    }

    .choose {
        margin-top: auto;
    }
</style>

<div class="col-sm-9 padding-right">
    <div class="features_items">
        <!--features_items-->
        <h2 class="title text-center">Features Items</h2>
        @foreach (var item in Model)
        {
            <div class="col-sm-4">
                <div class="product-image-wrapper">

                    <div class="single-products">
                        <div class="productinfo text-center">
                            <a asp-action="Details" asp-controller="Product" asp-route-Id="@item.Id">
                                <img src="~/media/products/@item.Image" alt="@item.Name" width="100%" />
                                <h2>@item.Price.ToString("#,##0 VNĐ")</h2>
                                <p>@item.Name</p>
                                <p>Danh mục : @item.Category.Name</p>
                                <p>Thương hiệu : @item.Brand.Name</p>
                            </a>

                            @if (item.Quantity > 0)
                            {
                                @* <a class="btn btn-default add-to-cart" asp-action="AddCartProduct" asp-controller="Cart" asp-route-Id="@item.Id"><i class="fa fa-shopping-cart"></i>Thêm vào giỏ hàng</a> *@
                                @* Code bằng Ajax *@
                                <button class="btn btn-default add-to-cart" data-product_id="@item.Id"><i class="fa fa-shopping-cart"></i>Thêm vào giỏ hàng</button>
                            }   
                            else
                            {
                                <button class="btn btn-default"><i class="fa fa-shopping-cart"></i>Hết hàng</button>
                            }
                        </div>
                    </div>

                    <div class="choose">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <ul class="nav nav-pills nav-justified">
                                <li><button class="btn btn-danger add-btn-wishlist" data-product_id="@item.Id">Yêu thích</button></li>
                                <li><button class="btn btn-primary add-btn-compare" data-product_id="@item.Id"> So sánh</button></li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
    </div><!--features_items-->

</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $('.add-to-cart').click(function () {

                var Id = $(this).data("product_id"); 

                // Gửi Ajax request đến controller 
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddCartProduct", "Cart")", // Gửi tới Action
                    data: { Id: Id },

                    success: function (result) {
                        // Handle successful update
                        if (result) {
                            Swal.fire({
                                position: "top-end",
                                icon: "success",
                                title: "Thêm giỏ hàng thành công.",
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    }
                });
            });
        });
    </script>

    <!--Add to Wishlist Script-->
    <script>
        $(document).ready(function () {

            $('.add-btn-wishlist').click(function () {

                var Id = $(this).data("product_id");

                // Gửi Ajax request đến controller
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddWishlist", "Home")", // Gửi tới Action
                    data: { Id: Id },

                    success: function (result) {
                        // Handle successful update
                        if (result) {
                            Swal.fire({
                                position: "top-end",
                                icon: "success",
                                title: "Thêm yêu thích thành công.",
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    }
                });
            });
        });
    </script>
    <!--/Add to Wishlist Script-->

    <!--Add to Compare Script-->
    <script>
        $(document).ready(function () {

            $('.add-btn-compare').click(function () {

                var Id = $(this).data("product_id");

                // Gửi Ajax request đến controller
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("AddCompare", "Home")", // Gửi tới Action
                    data: { Id: Id },

                    success: function (result) {
                        // Handle successful update
                        if (result) {
                            Swal.fire({
                                position: "top-end",
                                icon: "success",
                                title: "Thêm so sánh sản phẩm thành công.",
                                showConfirmButton: false,
                                timer: 1500
                            });
                        }
                    }
                });
            });
        });
    </script>
    <!--/Add to Compare Script-->
}
