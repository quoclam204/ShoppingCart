@{
    ViewData["Title"] = "List Compare";

    var key = 0;
}

<h3>Danh sách so sánh</h3>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">STT</th>
            <th scope="col">Tên sản phẩm</th>
            <th scope="col">Mô tả</th>
            <th scope="col">Giá</th>
            <th scope="col">Hình ảnh</th>
            <th scope="col">Thao tác</th>
        </tr>       
    </thead>
    <tbody>
        @foreach (var compare_product in Model)
        {
            key++;
            <tr>
                <th>@key</th>
                <td>@compare_product.Product.Name</td>
                <td>@Html.Raw(compare_product.Product.Description)</td>
                <td>@compare_product.Product.Price.ToString("#,##0 VNĐ")</td>
                <td><img src="~/media/products/@compare_product.Product.Image" width="120px">
                <td>
                    <a asp-action="DeleteCompare" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Home" asp-route-Id="@compare_product.Compare.Id">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>