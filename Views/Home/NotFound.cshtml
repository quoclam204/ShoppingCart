@{
    ViewData["Title"] = "Not Found 404";
}

<div class="notfound">
    <img src="https://cdn-icons-png.flaticon.com/512/755/755014.png" />
    <h1>Không tìm thấy nội dung!</h1>
</div>

<style>
    .notfound {
        height: 100vh; /* chiếm full màn hình */
        display: flex;
        flex-direction: column; /* xếp dọc */
        justify-content: center; /* căn giữa theo chiều dọc */
        align-items: center; /* căn giữa theo chiều ngang */
        text-align: center;
        gap: 15px; /* khoảng cách giữa ảnh và chữ */
    }

        .notfound img {
            width: 500px; /* chỉnh kích thước icon */
        }
</style>